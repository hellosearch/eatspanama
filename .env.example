# Canonical production origin. Overridable per-environment so canonicals /
# hreflang / OG always point at the real domain even from a preview deploy.
NEXT_PUBLIC_SITE_URL=https://eatspanama.com

# Staging guard (scope R10): set to 1 on ANY non-production deploy.
# Emits X-Robots-Tag: noindex on every response AND meta robots noindex.
# Staging must never be indexable. Remove (or set 0) only at launch.
SITE_NOINDEX=1

